NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is also supported.
# Server-only; needed for staff invitations and immutable PDF storage.
# Never prefix this secret with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Required for reset and invitation redirects; no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional, server-only. Leave disabled before entering real business data.
ENABLE_TEST_DATA_RESET=false
TEST_DATA_RESET_PROJECT_REF=
